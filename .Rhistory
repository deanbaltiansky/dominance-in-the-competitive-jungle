df_s3b_managers_elg <- df_s3b_managers %>%
filter(att_1 == 1)
# -----------------------------
# 0) Specify variables
# -----------------------------
predictor  <- "CWV"
outcome    <- "is_dom"
mediators  <- c("attitude_dom", "comp_dom")
controls   <- c("age","white","man","edu_num","income_num")
cluster_id <- "MID_dom"
# -----------------------------
# 1) Shared analytic sample
# -----------------------------
vars_needed <- c(outcome, predictor, mediators, controls, cluster_id)
df_cc <- df_s3b_managers_elg[complete.cases(df_s3b_managers_elg[, vars_needed]), vars_needed]
# -----------------------------
# 2) Reduced-form c path from mixed model (THIS is your c)
# -----------------------------
f_c <- as.formula(
paste0(outcome, " ~ ", predictor, " + ",
paste(controls, collapse = " + "),
" + (1|", cluster_id, ")")
)
m_c <- lmerTest::lmer(f_c, data = df_cc)
# Extract CWV row with estimate, SE, CI, p
c_row <- {
sm <- summary(m_c)
est <- sm$coefficients[predictor, "Estimate"]
se  <- sm$coefficients[predictor, "Std. Error"]
p   <- sm$coefficients[predictor, "Pr(>|t|)"]
# 95% CI from profile/WAld; confint can be slow with profile, so use Wald
ci <- suppressMessages(confint(m_c, parm = predictor, method = "Wald"))
tibble(
label = "c",
est = as.numeric(est),
se  = as.numeric(se),
ci.lower = as.numeric(ci[1]),
ci.upper = as.numeric(ci[2]),
pvalue = as.numeric(p)
)
}
# -----------------------------
# 3) Mediation system from lavaan (a/b/c' + indirects)
#     NOTE: cluster= gives clustered SEs, not random intercepts.
#     That's OK: c is sourced from the mixed model as requested.
# -----------------------------
controls_str <- paste(controls, collapse = " + ")
model_med <- paste0(
# a paths
mediators[1], " ~ a1*", predictor, " + ", controls_str, "\n",
mediators[2], " ~ a2*", predictor, " + ", controls_str, "\n\n",
# allow mediators to covary
mediators[1], " ~~ ", mediators[2], "\n\n",
# outcome equation with mediators -> c'
outcome, " ~ b1*", mediators[1], " + b2*", mediators[2],
" + c_prime*", predictor, " + ", controls_str, "\n\n",
# indirects (lavaan will compute SE/CI for defined params)
"ind1 := a1*b1\n",
"ind2 := a2*b2\n",
"ind_total := ind1 + ind2\n"
# DO NOT define total here, because your c is coming from lmer.
)
fit_med <- sem(
model_med,
data = df_cc,
cluster = cluster_id,
se = "robust.cluster"
)
# Extract lavaan rows
keep_labels <- c("a1","a2","b1","b2","c_prime","ind1","ind2","ind_total")
lavaan_rows <- parameterEstimates(fit_med, ci = TRUE) %>%
filter(label %in% keep_labels) %>%
select(label, est, se, ci.lower, ci.upper, pvalue)
# Pull c_prime and ind_total point estimates from lavaan
cprime_est <- lavaan_rows$est[lavaan_rows$label == "c_prime"]
indtot_est <- lavaan_rows$est[lavaan_rows$label == "ind_total"]
total_row <- c_row %>%
mutate(label = "total")
final_table <- bind_rows(
lavaan_rows,
c_row,
total_row
# , diag_row
) %>%
mutate(
label = factor(
label,
levels = c("a1","a2","b1","b2","c","c_prime","ind1","ind2","ind_total","total")
)
) %>%
arrange(label)
final_table
model <- '
# Mediator regressions
attitude_dom  ~ a1 * CWV
comp_dom ~ a2 * CWV
# Outcome regression
is_dom ~ b1 * attitude_dom + b2 * comp_dom + c_prime * CWV
# Indirect effects
ind1 := a1 * b1
ind2 := a2 * b2
ind_total := ind1 + ind2
total := c_prime + ind_total
'
fit <- sem(model, data = df_s3b_managers_elg,
cluster = "message_dom",
se = "robust.cluster")
estimates <- parameterEstimates(fit, standardized = TRUE, ci = TRUE, boot.ci.type = "perc")
effects_table <- estimates %>%
filter(label %in% c("a1","a2","b1","b2","c_prime","ind1","ind2","ind_total","total")) %>%
dplyr::select(label, est, se, ci.lower, ci.upper, pvalue)
effects_table
# Step 1: Fit the mediator model
med.fit <- lme4::lmer(impact_quit ~ CWV + (1|og_pid) + age + white + man + edu_num + income_num, df_s2_elg, REML=F)
# Step 2: Fit the outcome model
out.fit <- lme4::lmer(own_likeman ~ impact_quit + CWV + (1|og_pid) + age + white + man + edu_num + income_num, df_s2_elg, REML=F)
# Step 3: Conduct the mediation analysis
med.out <- mediate(med.fit, out.fit,
treat = "CWV",
mediator = "impact_quit",
boot = FALSE,
sims = 10000,
boot.ci.type="bca")
med_results <- data.frame(
Effect = c("ACME (indirect)", "ADE (direct)", "Total Effect", "Prop. Mediated"),
Estimate = round(c(med.out$d0, med.out$z0, med.out$tau.coef, med.out$n0), 3),
`95% CI Lower` = round(c(med.out$d0.ci[1], med.out$z0.ci[1], med.out$tau.ci[1], med.out$n0.ci[1]), 3),
`95% CI Upper` = round(c(med.out$d0.ci[2], med.out$z0.ci[2], med.out$tau.ci[2], med.out$n0.ci[2]), 3),
`p-value` = signif(c(med.out$d0.p, med.out$z0.p, med.out$tau.p, med.out$n0.p), 3)
)
med_results
