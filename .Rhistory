df_s1 <- read.csv("https://osf.io/snt3w/download")
df_s2 <- read.csv("https://osf.io/ncw98/download")
df_s3a_managers <- read.csv("https://osf.io/j4bmy/download")
df_s3a_employees <- read.csv("https://osf.io/qh7wa/download")
df_s3b_managers <- read.csv("https://osf.io/h6ytf/download")
df_s3b_employees <- read.csv("https://osf.io/q94jp/download")
df_s4 <- read.csv("https://osf.io/edpn3/download")
set.seed(20240914)
df_s2 <- df_s2 %>%
mutate(income = factor(income,c("$0-$20,000",
"$20,001-$40,000",
"$40,001-$60,000",
"$60,001-$80,000",
"$80,001-$100,000",
"$100,001-$120,000",
"$120,001-$140,000",
"$140,001-$160,000",
"$160,001-$180,000",
"$180,001-$200,000",
"Over $200,000")),
edu = factor(edu,c("noHS",
"GED",
"2yearColl",
"4yearColl",
"MA",
"PHD")),
income_num = as.numeric(income),
edu_num = as.numeric(edu),
white = ifelse(race == "white",1,0),
man = ifelse(gender == "man",1,0))
df_s2_elg <- df_s2 %>%
filter(elg == 1)
m1 <- lmerTest::lmer(own_likeman ~ CWV + (1|og_pid) + age + white + man + edu_num + income_num,data = df_s2_elg)
eta_table <- eta_squared(m1)
etas_for_table <- c(NA,eta_table$Eta2_partial)
apa_lm <- apa_print(m1)
table_for_print <- apa_lm$table %>%
mutate(eta2 = round(etas_for_table,3))
table_for_print
model <- '
# Mediator regressions
impact_rel  ~ a1 * CWV + age + white + man + edu_num + income_num
impact_comp ~ a2 * CWV + age + white + man + edu_num + income_num
# Outcome regression
own_likeman ~ b1 * impact_rel + b2 * impact_comp + c_prime * CWV + age + white + man + edu_num + income_num
# Indirect effects
ind1 := a1 * b1
ind2 := a2 * b2
ind_total := ind1 + ind2
total := c_prime + ind_total
'
fit <- sem(model, data = df_s2_elg,
cluster = "og_pid",
se = "robust.cluster")
estimates <- parameterEstimates(fit, standardized = TRUE, ci = TRUE, boot.ci.type = "perc")
effects_table <- estimates %>%
filter(label %in% c("a1","a2","b1","b2","c_prime","ind1","ind2","ind_total","total")) %>%
dplyr::select(label, est, se, ci.lower, ci.upper, pvalue)
effects_table
model_revised <- '
############################
# Mediator regressions
############################
impact_rel  ~ a1 * CWV + age + white + man + edu_num + income_num
impact_comp ~ a2 * CWV + age + white + man + edu_num + income_num
# Allow mediators to covary
impact_rel ~~ impact_comp
############################
# Outcome regression (with mediator)
############################
own_likeman ~ b1 * impact_rel +
b2 * impact_comp +
c_prime * CWV +
age + white + man + edu_num + income_num
############################
# Reduced-form total effect
############################
own_likeman ~ c * CWV
############################
# Indirect effects
############################
ind1 := a1 * b1
ind2 := a2 * b2
ind_total := ind1 + ind2
############################
# Decomposition check
############################
total := c_prime + ind_total
'
fit_revised <- sem(
model_revised,
data = df_s2_elg,
cluster = "og_pid",
se = "robust.cluster"
)
vars_needed <- c("own_likeman","CWV","impact_rel","impact_comp",
"age","white","man","edu_num","income_num","og_pid")
df_cc <- df_s2_elg[complete.cases(df_s2_elg[, vars_needed]), ]
m1_cc <- lmerTest::lmer(
own_likeman ~ CWV + age + white + man + edu_num + income_num + (1|og_pid),
data = df_cc
)
model_med <- '
impact_rel  ~ a1*CWV + age + white + man + edu_num + income_num
impact_comp ~ a2*CWV + age + white + man + edu_num + income_num
impact_rel ~~ impact_comp
own_likeman ~ b1*impact_rel + b2*impact_comp + c_prime*CWV +
age + white + man + edu_num + income_num
ind1 := a1*b1
ind2 := a2*b2
ind_total := ind1 + ind2
total := c_prime + ind_total
'
fit_med <- sem(model_med, data=df_cc, cluster="og_pid", se="robust.cluster")
model_c <- '
own_likeman ~ c*CWV + age + white + man + edu_num + income_num
'
fit_c <- sem(model_c, data=df_cc, cluster="og_pid", se="robust.cluster")
m1_cc <- lmerTest::lmer(
own_likeman ~ CWV + age + white + man + edu_num + income_num + (1|og_pid),
data = df_cc
)
coef_mixed
coef_mixed <- summary(m1_cc)$coefficients["CWV", c("Estimate","Pr(>|t|)")]
coef_mixed
