median == 3 ~ "$40,001-$60,000",
median == 4 ~ "$60,001-$80,000",
median == 5 ~ "$80,001-$100,000",
median == 6 ~ "$100,001-$120,000",
median == 7 ~ "$120,001-$140,000",
median == 8 ~ "$140,001-$160,000",
