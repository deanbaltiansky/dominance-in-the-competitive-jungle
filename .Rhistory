# -----------------------------
# 0) Specify variables
# -----------------------------
predictor <- "CWV"
outcome   <- "own_likeman"
mediators <- c("impact_rel", "impact_comp")
controls  <- c("age", "white", "man", "edu_num", "income_num")
cluster_id <- "og_pid"
# Optional: label the a/b paths in the same order as mediators
a_labels <- c("a1", "a2")
b_labels <- c("b1", "b2")
# -----------------------------
# 1) Create shared analytic sample
# -----------------------------
vars_needed <- c(outcome, predictor, mediators, controls, cluster_id)
df_cc <- df_s2_elg[complete.cases(df_s2_elg[, vars_needed]), vars_needed]
# -----------------------------
# 2) Build lavaan model string
# -----------------------------
controls_str <- paste(controls, collapse = " + ")
# a-paths
med_eqs <- paste0(
mediators, " ~ ", a_labels, "*", predictor,
if (length(controls) > 0) paste0(" + ", controls_str) else "",
collapse = "\n"
)
# mediator covariance (critical in parallel mediation)
med_cov <- paste(mediators, collapse = " ~~ ")
# b-paths + c'
out_eq <- paste0(
outcome, " ~ ",
paste0(b_labels, "*", mediators, collapse = " + "),
" + c_prime*", predictor,
if (length(controls) > 0) paste0(" + ", controls_str) else ""
)
# indirects / totals
ind_defs <- paste0(
"ind1 := ", a_labels[1], "*", b_labels[1], "\n",
"ind2 := ", a_labels[2], "*", b_labels[2], "\n",
"ind_total := ind1 + ind2\n",
"total := c_prime + ind_total"
)
model_med <- paste(
med_eqs,
med_cov,
out_eq,
ind_defs,
sep = "\n\n"
)
# -----------------------------
# 3) Fit model (cluster-robust SEs)
# -----------------------------
fit_med <- sem(
model_med,
data = df_cc,
cluster = cluster_id,
se = "robust.cluster"
)
# -----------------------------
# 4) Extract the exact table you want
# -----------------------------
keep_labels <- c("a1","a2","b1","b2","c_prime","ind1","ind2","ind_total","total")
effects_table <- parameterEstimates(fit_med, ci = TRUE) %>%
filter(label %in% keep_labels) %>%
select(label, est, se, ci.lower, ci.upper, pvalue) %>%
mutate(
label = factor(label, levels = keep_labels)
) %>%
arrange(label)
effects_table
# -----------------------------
# 0) Specify variables
# -----------------------------
predictor  <- "CWV"
outcome    <- "own_likeman"
mediators  <- c("impact_rel", "impact_comp")
controls   <- c("age","white","man","edu_num","income_num")
cluster_id <- "og_pid"
# -----------------------------
# 1) Shared analytic sample
# -----------------------------
vars_needed <- c(outcome, predictor, mediators, controls, cluster_id)
df_cc <- df_s2_elg[complete.cases(df_s2_elg[, vars_needed]), vars_needed]
f_c <- as.formula(
paste0(outcome, " ~ ", predictor, " + ",
paste(controls, collapse = " + "),
" + (1|", cluster_id, ")")
)
m_c <- lmerTest::lmer(f_c, data = df_cc)
c_row <- {
sm <- summary(m_c)
est <- sm$coefficients[predictor, "Estimate"]
se  <- sm$coefficients[predictor, "Std. Error"]
p   <- sm$coefficients[predictor, "Pr(>|t|)"]
# 95% CI from profile/WAld; confint can be slow with profile, so use Wald
ci <- suppressMessages(confint(m_c, parm = predictor, method = "Wald"))
tibble(
label = "c",
est = as.numeric(est),
se  = as.numeric(se),
ci.lower = as.numeric(ci[1]),
ci.upper = as.numeric(ci[2]),
pvalue = as.numeric(p)
)
}
# -----------------------------
# 3) Mediation system from lavaan (a/b/c' + indirects)
#     NOTE: cluster= gives clustered SEs, not random intercepts.
#     That's OK: c is sourced from the mixed model as requested.
# -----------------------------
controls_str <- paste(controls, collapse = " + ")
model_med <- paste0(
# a paths
mediators[1], " ~ a1*", predictor, " + ", controls_str, "\n",
mediators[2], " ~ a2*", predictor, " + ", controls_str, "\n\n",
# allow mediators to covary
mediators[1], " ~~ ", mediators[2], "\n\n",
# outcome equation with mediators -> c'
outcome, " ~ b1*", mediators[1], " + b2*", mediators[2],
" + c_prime*", predictor, " + ", controls_str, "\n\n",
# indirects (lavaan will compute SE/CI for defined params)
"ind1 := a1*b1\n",
"ind2 := a2*b2\n",
"ind_total := ind1 + ind2\n"
# DO NOT define total here, because your c is coming from lmer.
)
fit_med <- sem(
model_med,
data = df_cc,
cluster = cluster_id,
se = "robust.cluster"
)
# Extract lavaan rows
keep_labels <- c("a1","a2","b1","b2","c_prime","ind1","ind2","ind_total")
lavaan_rows <- parameterEstimates(fit_med, ci = TRUE) %>%
filter(label %in% keep_labels) %>%
select(label, est, se, ci.lower, ci.upper, pvalue)
cprime_est <- lavaan_rows$est[lavaan_rows$label == "c_prime"]
indtot_est <- lavaan_rows$est[lavaan_rows$label == "ind_total"]
total_row <- c_row %>%
mutate(label = "total")
final_table <- bind_rows(
lavaan_rows,
c_row,
total_row
# , diag_row
) %>%
mutate(
label = factor(
label,
levels = c("a1","a2","b1","b2","c","c_prime","ind1","ind2","ind_total","total")
)
) %>%
arrange(label)
final_table
