Alright, now, we're gonna assign a cluster to each participant based on their mean-centered embedding's cosine similarity with the cluster's mean embedding. So, the closer they are to cluster, the more likely they are to be categorized as that cluster.

L2-normalize each reason vector (so dot products = cosine).

For each person, take the mean of their unit vectors (their “person vector”).

Compare that person vector to each cluster centroid (cosine = average similarity to that cluster); pick the max.

```{r}
# prepe the df
df <- df_long %>% 
  left_join(df_embeddings,by = "reason") %>% 
  select(-reason_id)


assign_person_clusters <- function(df, km, id_col = "id") {
  # 1) find embedding columns (support V1.. and dim_1..)
  emb_cols <- grep("^V\\d+$|^dim_\\d+$", names(df), value = TRUE)
  if (!length(emb_cols)) stop("No embedding columns found (expecting V1.. or dim_1..).")
  if (!id_col %in% names(df)) stop("id column not found: ", id_col)

  # 2) L2-normalize each reason vector
  M <- as.matrix(df[, emb_cols, drop = FALSE])
  nrms <- sqrt(rowSums(M * M))
  ok   <- is.finite(nrms) & nrms > 0
  U    <- M[ok, , drop = FALSE] / nrms[ok]
  ids  <- df[[id_col]][ok]

  # 3) Person-level mean unit vector (one row per person)
  idx_by_id <- split(seq_len(nrow(U)), ids)
  MU_list <- lapply(idx_by_id, function(rows) {
    colMeans(U[rows, , drop = FALSE])  # average of unit vectors
  })
  MU <- do.call(rbind, MU_list)        # people x dims
  people <- names(idx_by_id)
  n_reasons <- vapply(idx_by_id, length, integer(1))

  # 4) Normalize cluster centroids to unit length
  C <- km$centers
  C <- C / sqrt(rowSums(C * C))

  # 5) Scores = average cosine to each cluster (mean of cosines)
  #    (since mu·c = mean_i (u_i·c))
  S <- MU %*% t(C)                     # people x k matrix, in [-1, 1]

  # 6) Pick best cluster; also report second-best and margin
  best_idx <- max.col(S, ties.method = "first")
  best_val <- S[cbind(seq_len(nrow(S)), best_idx)]

  # second best
  second_idx <- apply(S, 1, function(x) {
    if (all(!is.finite(x))) return(NA_integer_)
    ord <- order(x, decreasing = TRUE)
    if (length(ord) >= 2) ord[2] else NA_integer_
  })
  second_val <- mapply(function(i, j) if (is.na(j)) NA_real_ else S[i, j],
                       seq_len(nrow(S)), second_idx)

  # 7) Mean resultant length (cohesion of a person's reasons)
  mrl <- sqrt(rowSums(MU * MU))

  # 8) Assemble output
  tibble(
    !!id_col := people,
    n_reasons = n_reasons,
    mrl = mrl,
    assigned_cluster = best_idx,
    avg_cosine_to_assigned = best_val,          # mean cosine to chosen centroid
    second_best_cluster = second_idx,
    second_best_avg_cosine = second_val,
    margin = best_val - second_val
  )
}

df_PIDreasonclusters <- assign_person_clusters(df,km)

