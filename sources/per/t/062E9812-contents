## Create functions

```{r}
# packages
library(httr2)
library(jsonlite)

gpt_structured_responses <- function(
  context_text,
  response_text,
  schema,  # list(name=..., strict=..., schema=list(...))
  model = "gpt-4o-mini-2024-07-18",
  temperature = 0,
  max_retries = 3,
  verbose = TRUE
) {
  stopifnot(!is.null(schema$name), !is.null(schema$strict), !is.null(schema$schema))

  prompt <- paste0(
    "TASK:\nReturn a JSON object that STRICTLY matches the schema.\n\n",
    "CONTEXT (coding manual / background):\n", context_text,
    "\n\nTEXT TO CODE:\n", response_text
  )

body <- list(
  model = model,
  input = prompt,
  temperature = temperature,
  text = list(
    format = list(
      type   = "json_schema",
      name   = schema$name,       # required at this level
      schema = schema$schema,     # <-- put your JSON Schema HERE
      strict = schema$strict      # enforce exact shape
    )
  ),
  max_output_tokens = 500
)

  # Helpers
  safe_has_text <- function(x) {
    is.character(x) && length(x) >= 1 && !is.na(x[1]) && nzchar(x[1])
  }
  parse_any_json <- function(txt) {
    if (safe_has_text(txt)) {
      out <- try(jsonlite::fromJSON(txt, simplifyVector = TRUE), silent = TRUE)
      if (!inherits(out, "try-error")) return(out)
    }
    NULL
  }

  attempt <- 1
  repeat {
    req <- httr2::request("https://api.openai.com/v1/responses") |>
      httr2::req_headers(
        Authorization = paste("Bearer", Sys.getenv("OPENAI_API_KEY")),
        "Content-Type" = "application/json"
      ) |>
      httr2::req_body_json(body) |>
      httr2::req_error(is_error = function(resp) FALSE)

    resp <- httr2::req_perform(req)
    status <- httr2::resp_status(resp)

    if (status >= 200 && status < 300) {
      out <- httr2::resp_body_json(resp)

      # Preferred parsed locations
      if (!is.null(out$output_parsed)) return(out$output_parsed)

      if (!is.null(out$output) && length(out$output) > 0) {
        for (i in seq_along(out$output)) {
          if (!is.null(out$output[[i]]$parsed)) return(out$output[[i]]$parsed)
          content_i <- out$output[[i]]$content
          if (!is.null(content_i) && length(content_i) > 0) {
            for (j in seq_along(content_i)) {
              parsed <- content_i[[j]]$parsed
              if (!is.null(parsed)) return(parsed)
            }
          }
        }
      }

      # Fallback: try text fields
      cand <- NULL
      if (!is.null(out$output_text)) cand <- out$output_text
      if (is.null(cand) && !is.null(out$output) && length(out$output) > 0) {
        c1 <- try(out$output[[1]]$content[[1]]$text, silent = TRUE)
        if (!inherits(c1, "try-error")) cand <- c1
      }
      parsed <- parse_any_json(cand)
      if (!is.null(parsed)) return(parsed)

      if (verbose) message("No parsed content found. Raw response:\n", jsonlite::toJSON(out, auto_unbox = TRUE))
      return(NULL)
    } else {
      if (verbose) {
        message("HTTP ", status, " from Responses API.\n--- Body ---\n",
                httr2::resp_body_string(resp))
      }
    }

    if (attempt >= max_retries) return(NULL)
    Sys.sleep(runif(1, min = 1, max = 2^attempt))
    attempt <- attempt + 1
  }
}






