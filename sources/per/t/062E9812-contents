# Clustering

```{r}
library(cluster)

emb_cols <- grep("^V\\d+$", names(df_embeddings), value = TRUE)
stopifnot(length(emb_cols) > 0)

M <- as.matrix(df_embeddings[, emb_cols, drop = FALSE])
nrms <- sqrt(rowSums(M * M))
keep <- is.finite(nrms) & nrms > 0
if (!any(keep)) stop("No valid rows after L2-normalization.")

U <- M[keep, , drop = FALSE] / nrms[keep]   # unit vectors (cosine-friendly)
reasons <- df_embeddings$reason[keep]

# ----- 1) Cosine distance helper (clamps without dropping matrix dims) -----
cosine_dist <- function(U) {
  U <- as.matrix(U); storage.mode(U) <- "double"
  n <- nrow(U)
  if (n < 2) return(as.dist(matrix(0, n, n)))
  S <- tcrossprod(U)        # cosine similarity for unit vectors
  S[S >  1] <-  1           # clamp numeric noise
  S[S < -1] <- -1
  diag(S) <- 1
  D <- 1 - S
  D <- (D + t(D)) / 2       # enforce symmetry
  as.dist(D)
}

# ----- 2) Safe mean silhouette for a given k (skips bad k) -----
safe_sil_for_k <- function(k, U) {
  n <- nrow(U)
  if (n < 3 || k < 2 || k > n) return(NA_real_)
  set.seed(42)
  km <- kmeans(U, centers = k, nstart = 25)
  cl <- km$cluster
  sz <- as.vector(table(cl))
  if (length(sz) < 2 || any(sz < 2)) return(NA_real_)   # skip empty/singletons
  Dk <- cosine_dist(U)                                   # matches THIS U
  mean(silhouette(as.integer(cl), Dk)[, "sil_width"], na.rm = TRUE)
}

# ----- 3) Scan k and pick the best by silhouette -----
n <- nrow(U)
ks <- if (n >= 3) 2:min(12, n - 1) else integer(0)
sil <- if (length(ks)) sapply(ks, safe_sil_for_k, U = U) else numeric(0)

valid <- which(!is.na(sil))

k <- if (!length(ks) || length(valid) == 0) {
  if (nrow(U) >= 2) 2 else 1   # fallback if all NA or no ks
} else {
  ks[ valid[ which.max(sil[valid]) ] ]
}

cat("Chosen k =", k, "\n")

# ----- 4) Final k-means and outputs -----
set.seed(20251001)
k = 10 
km <- kmeans(U, centers = k, nstart = 50, iter.max = 100)
clusters <- km$cluster

clusters_df <- tibble(reason = reasons, cluster = clusters)

# Optional: exemplar reasons per cluster by cosine-to-centroid
C <- km$centers
C <- C / sqrt(rowSums(C * C))
cos2C <- U %*% t(C)

topN <- 5
top_examples <- bind_rows(lapply(seq_len(k), function(c) {
  idx <- which(clusters == c)
  if (!length(idx)) return(tibble(cluster = integer(), reason = character(), cosine_to_centroid = numeric()))
  ord <- order(cos2C[idx, c], decreasing = TRUE)
  tibble(
    cluster = c,
    reason  = reasons[idx][ord][seq_len(min(topN, length(idx)))],
    cosine_to_centroid = cos2C[idx, c][ord][seq_len(min(topN, length(idx)))]
  )
}))

