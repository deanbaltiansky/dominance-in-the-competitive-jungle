# optional helper (from earlier)
clean_reasons <- function(xs) {
  if (is.null(xs)) return(character())
  xs <- tolower(trimws(xs))
  xs <- xs[xs != ""]
  xs <- gsub("\\s+", " ", xs)
  xs <- gsub(",", "", xs)
  unique(xs)[seq_len(min(length(xs), 10))]
}

code_all <- function(df, extra_context = "") {
  n <- nrow(df)

  purrr::pmap_dfr(list(df$response, df$id, seq_len(n)), function(txt, id, i) {
    message(sprintf("Coding row %d/%d (id=%s)...", i, n, id))

    s  <- gpt_left_behind_score(txt, extra_context);               if (is.null(s))  message("  - score FAILED")
    r  <- gpt_reasons(txt, extra_context);                         if (is.null(r))  message("  - reasons FAILED")
    sy <- gpt_systemic(txt, extra_context);                        if (is.null(sy)) message("  - systemic FAILED")
    g  <- gpt_government(txt, extra_context);                      if (is.null(g))  message("  - government FAILED")
    ec <- gpt_economic(txt, extra_context);            if (is.null(ec)) message("  - econ FAILED")
    cul <- gpt_cultural(txt, extra_context); if (is.null(cul)) message("  - cult FAILED")
    ra <- gpt_race(txt, extra_context);            if (is.null(ra)) message("  - race FAILED")
    ge <- gpt_gender(txt, extra_context);            if (is.null(ge)) message("  - gender FAILED")
    ag <- gpt_age(txt, extra_context);            if (is.null(ag)) message("  - age FAILED")

    # define reasons_* safely
    reasons_vec <- clean_reasons(if (!is.null(r)) r$reasons else character())
    reasons_csv <- if (length(reasons_vec)) paste(reasons_vec, collapse = ", ") else NA_character_

    tibble::tibble(
  id                = id,
  left_behind_score = suppressWarnings(as.numeric(if (!is.null(s))   s$left_behind_score else NA_real_)),
  reasons_csv       = reasons_csv,
  systemic          = suppressWarnings(as.numeric(if (!is.null(sy))  sy$systemic else NA_real_)),
  government        = suppressWarnings(as.numeric(if (!is.null(g))   g$government else NA_real_)),
  economic          = suppressWarnings(as.numeric(if (!is.null(ec))  ec$economic else NA_real_)),
  cultural          = suppressWarnings(as.numeric(if (!is.null(cul)) cul$cultural else NA_real_)),
  race              = suppressWarnings(as.numeric(if (!is.null(ra))  ra$race else NA_real_)),
  gender            = suppressWarnings(as.numeric(if (!is.null(ge))  ge$gender else NA_real_)),
  age               = suppressWarnings(as.numeric(if (!is.null(ag))  ag$age else NA_real_))
)
    
  })
