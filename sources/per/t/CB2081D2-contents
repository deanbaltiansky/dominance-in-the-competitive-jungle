### Mediation model

Outcome: support for policy\
Mediator: solidarity\
Predictor: zs_class\
Controls: zero-sum mindset, SDO, conservatism, age, race (white = 1; non-white = 0), gender (man = 1; non-man = 0), income, education, SES.

```{r,echo=FALSE,results='asis',warning=FALSE,message=F,fig.align='left'}
# Step 1: Fit the mediator model
# soli ~ predictor + controls
med.fit <- lm(soli ~ zs_class + SDO + zsm + ideo_con + age + income_num + edu_num + ses_num + white + man,
              data = df_sup1_elg)

# Step 2: Fit the outcome model
# support ~ predictor + mediator + controls
out.fit <- lm(support ~ zs_class + soli + SDO + zsm + ideo_con + age + income_num + edu_num + ses_num + white + man,
              data = df_sup1_elg)

# Step 3: Conduct the mediation analysis
med.out <- mediate(med.fit, out.fit,
                   treat = "zs_class",
                   mediator = "soli",
                   boot = TRUE, sims = 10000) 

# Step 4: Create table
med_results <- data.frame(
  Effect = c("ACME (indirect)", "ADE (direct)", "Total Effect", "Prop. Mediated"),
  Estimate = round(c(med.out$d0, med.out$z0, med.out$tau.coef, med.out$n0), 3),
  `95% CI Lower` = round(c(med.out$d0.ci[1], med.out$z0.ci[1], med.out$tau.ci[1], med.out$n0.ci[1]), 3),
  `95% CI Upper` = round(c(med.out$d0.ci[2], med.out$z0.ci[2], med.out$tau.ci[2], med.out$n0.ci[2]), 3),
  `p-value` = signif(c(med.out$d0.p, med.out$z0.p, med.out$tau.p, med.out$n0.p), 3)
)

kableExtra::kable(med_results, caption = "Mediation Analysis Summary",
      booktabs = T,
      format = "latex",
      align = c("l",rep("c",5))) %>% 
  kable_styling(latex_options = "hold_position")

