### Moderated mediation model

Outcome: support for redistributive policy\
Mediator: class solidarity\
Predictor: class zero-sum beliefs\
Moderator (in the a and c paths): condition (advantage-gain frame vs. disadvantage-gain frame)\
Controls: zero-sum mindset

```{r,include=F}
fit <- PROCESS(df_s3_elg, 
               y = "support", 
               x = "zs_class",
               meds = "soli",
               mods = "cond",
               covs = "zsm",
               mod.path = c("x-m", "x-y"),
               ci = "boot", 
               nsim = 10000, 
               seed = 20250318)

# Extract a3 from the model predicting the mediator (soli)
a3 <- coef(fit$model.m$model.m.1)["zs_class:conddisadgain"]

m1_summary <- summary(fit$model.m$model.m.1)

a3_coef   <- m1_summary$coefficients["zs_class:conddisadgain", "Estimate"]
a3_se     <- m1_summary$coefficients["zs_class:conddisadgain", "Std. Error"]
a3_pval   <- m1_summary$coefficients["zs_class:conddisadgain", "Pr(>|t|)"]

# Extract b from the model predicting the outcome (support)
b  <- coef(fit$model.y)["soli"]

y_summary <- summary(fit$model.y)

b_coef   <- y_summary$coefficients["soli", "Estimate"]
b_se     <- y_summary$coefficients["soli", "Std. Error"]
b_pval   <- y_summary$coefficients["soli", "Pr(>|t|)"]

# Compute the index of moderated mediation
index_mod_med <- a3 * b

# boostrapping (for CI)

boot_fun <- function(data, indices) {
  d <- data[indices, ]

  tryCatch({
    mod <- PROCESS(d,
                   y = "support", 
                   x = "zs_class",
                   meds = "soli",
                   mods = "cond",
                   covs = "zsm",
                   mod.path = c("x-m", "x-y"),
                   ci = "boot", 
                   nsim = 1)
    
    a3 <- coef(mod$model.m$model.m.1)["zs_class:conddisadgain"]
    b  <- coef(mod$model.y)["soli"]

    return(a3 * b)

  }, error = function(e) {
    message("Boot iteration failed: ", conditionMessage(e))
    return(NA_real_)
  })
}

set.seed(20250318)
boot_out <- boot(df_s3_elg, boot_fun, R = 1000)
CIs <- boot.ci(boot_out, type = "perc")
lower_CI <- CIs$percent[4]
higher_CI <- CIs$percent[5]

boot_vals <- na.omit(boot_out$t[,1])
theta_hat <- boot_out$t0
boot_vals <- na.omit(boot_out$t[, 1])

if (theta_hat > 0) {
  p_val <- 2 * mean(boot_vals <= 0)
} else {
  p_val <- 2 * mean(boot_vals >= 0)
}
```

