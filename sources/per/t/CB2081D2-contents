## Mediation models with controls

### Mediation model 1

Predictor: Class zero-sum beliefs at T1\
Mediator: Perceived impact of a Harris presidency on the working class at T2\
Outcome: Vote for Harris
Controls: zero-sum mindset at T1, conservatism, income, education, age, race, gender

```{r,echo=FALSE,results='asis',warning=FALSE,message=F,fig.align='left'}
# Step 1: Fit the mediator model
med.fit <- lm(wrkint_harris_t2 ~ zs_class_t1 + zsm_t1 + ideo_con + income_num + edu_num + age + white + man,
              data = df_s5_elg)

# Step 2: Fit the outcome model
out.fit <- lm(vote_harris_t2 ~ zs_class_t1 + wrkint_harris_t2 + zsm_t1 + ideo_con + income_num + edu_num + age + white + man,
              data = df_s5_elg)

# Step 3: Conduct the mediation analysis
med.out <- mediation::mediate(med.fit, out.fit,
                   treat = "zs_class_t1",
                   mediator = "wrkint_harris_t2",
                   boot = TRUE, sims = 10000)

# Step 4: Create table
med_results <- data.frame(
  Effect = c("ACME (indirect)", "ADE (direct)", "Total Effect", "Prop. Mediated"),
  Estimate = round(c(med.out$d0, med.out$z0, med.out$tau.coef, med.out$n0), 3),
  `95% CI Lower` = round(c(med.out$d0.ci[1], med.out$z0.ci[1], med.out$tau.ci[1], med.out$n0.ci[1]), 3),
  `95% CI Upper` = round(c(med.out$d0.ci[2], med.out$z0.ci[2], med.out$tau.ci[2], med.out$n0.ci[2]), 3),
  `p-value` = signif(c(med.out$d0.p, med.out$z0.p, med.out$tau.p, med.out$n0.p), 3)
)

