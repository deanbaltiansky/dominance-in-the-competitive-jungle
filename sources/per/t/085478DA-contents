  unlist() %>% 
  unname()

words_to_cluster <- df_ourwords %>% 
  select(word) %>% 
  unlist() %>% 
  unname()

# Calculate cosine similarity matrix
cosine_sim_matrix <- tcrossprod(word_vectors, word_vectors) / (sqrt(rowSums(word_vectors^2)) %*% t(sqrt(rowSums(word_vectors^2))))

# Perform hierarchical clustering based on semantic similarity
hclust_result <- hclust(as.dist(1 - cosine_sim_matrix), method = "ward.D2")

# Set the number of clusters based on a cutoff in the dendrogram
num_clusters <- 8
clusters <- cutree(hclust_result, k = num_clusters)

# Print the clusters
for (i in 1:num_clusters) {
   cat("Cluster", i, ":", words_to_cluster[clusters == i], "\n")
 }


